<?xml version="1.0" encoding="utf-8"?>
<!--
   Aturan backup untuk Android 11 ke bawah.

   pembacakue_ad_prefs dikecualikan karena berisi "ad_free_until" — masa bebas
   iklan hasil menonton rewarded video. Kalau ikut di-backup, masa itu bisa
   diperpanjang berulang kali lewat restore.
   Status onboarding dikecualikan agar instalasi baru tetap mendapat panduan awal.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="pembacakue_ad_prefs.xml" />
    <exclude domain="sharedpref" path="pembacakue_onboarding.xml" />
</full-backup-content>
