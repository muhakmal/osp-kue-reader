<?xml version="1.0" encoding="utf-8"?>
<!--
   Aturan backup & transfer perangkat untuk Android 12+.

   Riwayat scan (Room) dan preferensi umum boleh ikut, supaya pengguna yang ganti
   HP tidak kehilangan datanya. pembacakue_ad_prefs dikecualikan karena
   menyimpan masa bebas iklan hasil rewarded video — kalau ikut ter-backup, masa
   itu bisa diperpanjang tanpa batas lewat restore berulang.
   Status onboarding juga dikecualikan agar panduan muncul pada instalasi baru.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="pembacakue_ad_prefs.xml" />
        <exclude domain="sharedpref" path="pembacakue_onboarding.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="pembacakue_ad_prefs.xml" />
        <exclude domain="sharedpref" path="pembacakue_onboarding.xml" />
    </device-transfer>
</data-extraction-rules>
